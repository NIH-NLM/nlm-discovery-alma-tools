# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real credentials.

# --- OCLC WorldCat Metadata API credentials ---
OCLC_WSKEY=
OCLC_SECRET=
# Alternative to the two vars above: point at a local key file instead
# (lines like "oclc_wskey=..." / "oclc_secret=...").
# OCLC_KEY_FILE=

# --- Alma API key ---
ALMA_API_KEY=
# Alternative to ALMA_API_KEY: point at a local key file with a line like
# "alma_api_key=..." (name configurable via ALMA_KEY_NAME).
# ALMA_API_KEY_FILE=
# ALMA_KEY_NAME=alma_api_key

# --- Alma institution endpoints (required) ---
# REST API base for bibs, e.g. https://api-na.hosted.exlibrisgroup.com/almaws/v1/bibs
ALMA_API_BASE=
# SRU base for your institution, e.g.
# https://YOUR_INST.alma.exlibrisgroup.com/view/sru/YOUR_INST_CODE
ALMA_SRU_URL=

# --- Electronic portfolio target (required) ---
PORTFOLIO_ECOLL_ID=
PORTFOLIO_ESVC_ID=
PORTFOLIO_LICENSE=
PORTFOLIO_ACTIVATION_DATE=2025-12-31Z
PORTFOLIO_LIBRARY=MAIN

# --- Optional: verify/set the e-service parser before running ---
# PARSER_NAME=Springer::BOOKS
# PARSER_URL=url=https://link.springer.com

# --- Optional tuning ---
# INPUT_XLSX=input.xlsx
# PROCESS_LIMIT=10
# OCLC_REQUEST_DELAY=0.5
